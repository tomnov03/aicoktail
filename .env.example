# Copie ce fichier en .env.local pour le développement local (jamais commité, voir .gitignore).
# En production (Vercel), configure ces variables dans
# Project Settings > Environment Variables — jamais dans le code.

# --- TheCocktailDB (recettes classiques) ---
# Clé de test publique "1" par défaut : gratuite, sans inscription, sans quota bloquant
# pour un usage personnel. Ce n'est PAS un secret. Optionnel : si tu deviens "Supporter"
# de TheCocktailDB, remplace par ta propre clé pour débloquer plus de requêtes.
NEXT_PUBLIC_COCKTAILDB_API_KEY=1

# --- Génération IA (optionnelle) ---
# Clé API Anthropic (https://console.anthropic.com/settings/keys). SECRET : ne jamais
# préfixer par NEXT_PUBLIC_, ne jamais commiter, ne jamais partager. Sans cette variable,
# l'application fonctionne normalement mais la génération de recettes IA est désactivée.
ANTHROPIC_API_KEY=

# Modèle utilisé pour la génération (optionnel, défaut : claude-opus-5)
ANTHROPIC_MODEL=claude-opus-5
